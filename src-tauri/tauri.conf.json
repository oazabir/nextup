{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Up",
  "version": "0.1.2",
  "identifier": "com.nextup.focus",
  "build": {
    "frontendDist": [
      "../index.html",
      "../app.js",
      "../style.css",
      "../task-reminder.html"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Next Up",
        "width": 420,
        "height": 180,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/oazabir/nextup/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MUI3NDhEMzM5REExRjcKUldUM29aMHpqWFFiT1pkR0ZnbEdIRUsvRnl5R0hNWTdOaU1EcnlVTjZZcVhFMUphYVZRQktPVXgK",
      "requireSignedVersion": true
    }
  }
}
